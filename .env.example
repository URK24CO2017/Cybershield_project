# ==========================================
# CyberShield - Environment Configuration
# ==========================================

# Database Configuration:
# 1. Local SQLite (Default):
DATABASE_URL=sqlite:///./cyber_shield.db
# 2. Supabase PostgreSQL (Replace [PROJECT_REF] and [YOUR_PASSWORD]):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Security & Encryption
CYBERSHIELD_SECRET_KEY=super-secret-cybershield-security-token-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PSEUDONYM_SALT=cybershield-hmac-salt-key-v1

# Smart Laboratory Defaults
LAB_NAME="AI Research Laboratory"
TIMEZONE="(UTC+0) London"
SESSION_TIMEOUT_MINUTES=30
MFA_ENABLED=true

# Frontend (For Vercel Deployment):
# Point this to your hosted backend (Render/Railway/Vercel)
VITE_API_URL=http://localhost:8000
